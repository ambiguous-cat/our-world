# Our World 配置模板（UTF-8）
# 在应用根目录复制为 .env.local，填写下面三个必填项后再初始化数据库、启动。
# Linux 生产部署请复制为 .env.production，不要同时保留本地 .env.local。
# 真实环境文件不得提交 Git；本模板仅包含空值、默认值和示例。
# 修改配置后重启应用。不要给以下变量添加 NEXT_PUBLIC_ 前缀。
# 值中含空格或 # 时用双引号包裹；字面 $ 需写作 \$。

# ── 1. 首次运行必填 ──
# 玩家用于登录的答案，同时作为登录后的玩家称呼展示给已登录的两人。
# 请自行设置，不要使用不希望在页面展示的内容。
PLAYER_ANSWER=

# 管理员用于登录的答案，不用于页面展示；必须与玩家答案不同。
ADMIN_ANSWER=

# 会话签名密钥：至少 32 字节的随机值；不要填写示例句子或登录答案。
# 在本机运行以下命令，将输出粘贴到等号后（32 随机字节转成 64 位十六进制）：
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# 更换此密钥会使现有会话失效，需要重新登录。
AUTH_SESSION_SECRET=

# ── 2. 本地运行默认配置 ──
# 路径相对于执行 npm 命令的应用根目录，使用正斜杠。
# 数据库与上传文件是运行数据，不随源码更新覆盖；生产请改用发布目录外的绝对路径。
DATABASE_PATH=./data/our-world.db
PRIZE_UPLOAD_DIR=./data/uploads/prizes

# 本地 HTTP 使用 false；正式 HTTPS 部署必须改为 true。
# true 时浏览器仅通过 HTTPS 发送会话 Cookie，HTTP 下无法正常保持登录。
AUTH_COOKIE_SECURE=false

# ── 3. 可选：玩家邮件通知 ──
# 默认关闭，不需要注册邮件服务或填写下面的邮件字段即可使用其他功能。
# 改为 true 后，管理员发券、新题版发布和首次全对奖励会创建邮件通知任务。
# 当前仅向玩家发送；站内未读消息不依赖邮件开关。
EMAIL_NOTIFICATIONS_ENABLED=false

# 仅启用邮件时必填：Resend 发送密钥、发件邮箱、发件名称、玩家收件邮箱、站点地址。
# 发件邮箱须满足 Resend 的验证要求；请使用自己的邮箱和域名。
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME="我们的小世界"
PLAYER_NOTIFICATION_EMAIL=
# 邮件按钮指向的完整站点地址，必须包含 /our-world；不用于设置端口或 Base Path。
# 本地 npm run dev 可用下面的值；正式部署例如 https://example.com/our-world。
OUR_WORLD_PUBLIC_URL=http://localhost:3000/our-world

# 选填：接收玩家回复邮件的真实邮箱；留空时不设置 Reply-To。
EMAIL_REPLY_TO=

# ── 4. 高级：全站登录失败限流 ──
# 可保持默认或删除这三行使用内置默认值。所有值必须为正整数。
# 在 600 秒内累计失败 5 次，锁定 900 秒；两种角色共用限流。
AUTH_LOGIN_RATE_LIMIT_MAX_FAILURES=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
AUTH_LOGIN_RATE_LIMIT_LOCK_SECONDS=900

# ── 5. Linux 生产示例（按自己的环境修改上面的对应项） ──
# DATABASE_PATH=/var/lib/our-world/app.db
# PRIZE_UPLOAD_DIR=/var/lib/our-world/uploads/prizes
# AUTH_COOKIE_SECURE=true
# OUR_WORLD_PUBLIC_URL=https://example.com/our-world
# 数据库命令默认加载生产配置；使用 .env.development* 时需显式设置 NODE_ENV=development。
# 已有进程环境变量优先于文件；.env.local 优先于 .env.production，因此生产不要保留前者。
